rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isOpsManagerOrAdmin() {
      return isAuthenticated() && (getUserData().role == 'operations_manager' || getUserData().role == 'admin');
    }

    function isConductor() {
      return isAuthenticated() && getUserData().role == 'conductor';
    }

    function isDriver() {
      return isAuthenticated() && getUserData().role == 'driver';
    }

    function isPassenger() {
      return isAuthenticated() && getUserData().role == 'passenger';
    }

    // 1. Users collection: users can read their own or ops manager can read all; self profile edit
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isOpsManagerOrAdmin();
      allow delete: if isOpsManagerOrAdmin();
    }

    // 2. Bus routes: publicly readable by authenticated users; editable only by Ops Manager/Admin
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isOpsManagerOrAdmin();
    }

    // 3. Buses collection: readable by all auth users; updated by driver/conductor assigned or ops
    match /buses/{busId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOpsManagerOrAdmin();
      allow update: if isOpsManagerOrAdmin() || isDriver() || isConductor();
    }

    // 4. Trips collection: readable by all auth users; manageable by crew or ops
    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isOpsManagerOrAdmin() || isDriver() || isConductor();
      allow update: if isOpsManagerOrAdmin() || isDriver() || isConductor();
      allow delete: if isOpsManagerOrAdmin();
    }

    // 5. Digital QR Tickets: passenger can read their own tickets; conductor and ops can read and create
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        isConductor() ||
        isOpsManagerOrAdmin()
      );
      allow create: if isAuthenticated() && (
        isPassenger() ||
        isConductor() ||
        isOpsManagerOrAdmin()
      );
      allow update, delete: if isOpsManagerOrAdmin();
    }

    // 6. Incidents: readable by all; drivers & ops can create; ops manager can resolve/update
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isDriver() || isConductor() || isOpsManagerOrAdmin());
      allow update: if isOpsManagerOrAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow delete: if isOpsManagerOrAdmin();
    }

    // 7. Notifications: readable if user is target role; ops can create/manage
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For marking as read
      allow delete: if isOpsManagerOrAdmin();
    }

    // 8. Reconciliations & Shifts
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update: if isConductor() || isOpsManagerOrAdmin();
      allow delete: if isOpsManagerOrAdmin();
    }

    match /reconciliations/{recId} {
      allow read: if isOpsManagerOrAdmin() || isConductor();
      allow write: if isOpsManagerOrAdmin();
    }

    // 9. Recurring Issues & Smart Insights
    match /recurring_issues/{issueId} {
      allow read: if isAuthenticated();
      allow write: if isOpsManagerOrAdmin();
    }

    match /smart_insights/{insightId} {
      allow read: if isAuthenticated();
      allow write: if isOpsManagerOrAdmin();
    }
  }
}
